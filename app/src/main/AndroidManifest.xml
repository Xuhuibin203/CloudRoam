<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".CloudRoamApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.CloudRoam">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 伪装引擎前台服务（通知栏常驻 + 关闭动作，FR-07） -->
        <service
            android:name=".engine.EngineService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 下拉快捷磁贴开关（FR-07） -->
        <service
            android:name=".engine.QuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/tile_label">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- libxposed 服务通道：service AAR 自带 XposedProvider 声明（authority=${applicationId}.XposedService），无需重复声明 -->

        <!-- 高德地图 Key：在 local.properties 配置 AMAP_KEY=xxx（FR-02） -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_KEY}" />
    </application>
</manifest>
